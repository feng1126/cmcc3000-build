#!/bin/sh

[ "$ACTION" = add ] || exit 0

device="$(uci -q get zerotier.global.mtu_device)"
mtu="$(uci -q get zerotier.global.mtu)"

case "$device" in
	zt????????) ;;
	*) exit 0 ;;
esac
case "$device" in
	*[!a-z0-9]*) exit 0 ;;
esac
case "$mtu" in
	*[!0-9]*|'') exit 0 ;;
esac
[ "$mtu" -ge 1280 ] 2>/dev/null && [ "$mtu" -le 2800 ] || exit 0
[ "$DEVICE" = "$device" ] || exit 0

ip link set dev "$device" mtu "$mtu"
